{
  "name": "autoclicker",
  "version": "1.0.0",
  "description": "AutoClicker - create sequenced clicks with fixed or random delays and run them in a loop.",
  "main": "src/main/main.js",
  "author": "Treszon",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.0"
  },
  "build": {
    "appId": "com.treszon.autoclicker",
    "productName": "AutoClicker",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@nut-tree-fork/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}